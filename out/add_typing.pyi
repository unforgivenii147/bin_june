import libcst as cst
from _typeshed import Incomplete
from pathlib import Path
from typing import Dict, Optional

class TypingCollector(cst.CSTVisitor):
    stack: Incomplete
    annotations: Incomplete
    def __init__(self) -> None: ...
    def visit_ClassDef(self, node: cst.ClassDef) -> Optional[bool]: ...
    def leave_ClassDef(self, node: cst.ClassDef) -> None: ...
    def visit_FunctionDef(self, node: cst.FunctionDef) -> Optional[bool]: ...
    def leave_FunctionDef(self, node: cst.FunctionDef) -> None: ...

class TypingTransformer(cst.CSTTransformer):
    stack: Incomplete
    annotations: Incomplete
    applied: int
    def __init__(self, annotations: Dict[tuple[str, ...], tuple[cst.Parameters, Optional[cst.Annotation]]]) -> None: ...
    def visit_ClassDef(self, node: cst.ClassDef) -> Optional[bool]: ...
    def leave_ClassDef(self, original_node: cst.ClassDef, updated_node: cst.ClassDef) -> cst.CSTNode: ...
    def visit_FunctionDef(self, node: cst.FunctionDef) -> Optional[bool]: ...
    def leave_FunctionDef(self, original_node: cst.FunctionDef, updated_node: cst.FunctionDef) -> cst.CSTNode: ...

def validate_syntax(code: str, filename: str) -> bool: ...
def apply_stub_annotations(source_path: Path, show_diff: bool = ...) -> bool: ...
def main() -> None: ...
